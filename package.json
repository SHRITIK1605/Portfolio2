{
  "name": "shritik-portfolio",
  "private": true,
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n portfolio,admin -c green,blue \"npm run dev:portfolio\" \"npm run dev:admin\"",
    "dev:portfolio": "npm run dev --workspace=apps/portfolio",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build": "npm run build --workspace=packages/database && npm run build --workspaces --if-present",
    "db:generate": "npm run generate --workspace=packages/database",
    "db:migrate": "npm run migrate --workspace=packages/database",
    "db:push": "npm run push --workspace=packages/database",
    "db:seed": "npm run seed --workspace=packages/database",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  }
}
